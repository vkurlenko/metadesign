<!DOCTYPE html>
<html lang="en">
<head>
    <title>{% block title %}MetaDesign{% endblock %}</title>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon -->
    <link href="/img/favicon2.png" rel="shortcut icon"/>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="{{ asset('/css/bootstrap.min.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/font-awesome.min.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/animate.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/magnific-popup.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/owl.carousel.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/style.css') }}"/>

</head>
<body>
<!-- Page Preloder -->
<div id="preloder">
    <div class="loader"></div>
</div>

<!-- Header section start -->
<header class="header-area">
    <a href="/" class="logo-area">
        <img src="/img/logo_new_transparent.png" alt="">
    </a>
    <div class="nav-switch">
        <i class="fa fa-bars"></i>
    </div>
    <div class="phone-number">
        <a href="tel:+{{ PHONE }}">{{ PHONE_FORMATED }}</a>
        <a href="https://t.me/metadesign_remont"><i class="fa fa-telegram"></i></a>
        <a href="https://api.whatsapp.com/send/?phone={{ PHONE }}"><i class="fa fa-whatsapp"></i></a>
    </div>
    <nav class="nav-menu">
        <ul>
            <li {% if CURRENT_PAGE == 'index' %} class="active" {% endif %}><a href="/">Главная</a></li>
            <li {% if CURRENT_PAGE == 'about' %} class="active" {% endif %}><a href="/about">О нас</a></li>
            <li {%
                if CURRENT_PAGE == 'portfolio'
                or CURRENT_PAGE == 'project'
                or CURRENT_PAGE == 'drawing'
                or CURRENT_PAGE == 'building'
            %} class="active" {% endif %}>
                <a href="/portfolio">Портфолио</a>
            </li>
            <li {% if CURRENT_PAGE == 'service' %} class="active" {% endif %}><a href="/#services">Услуги</a></li>
            <li {% if CURRENT_PAGE == 'contact' %} class="active" {% endif %}><a href="/#contact">Контакты</a></li>
        </ul>
    </nav>
</header>
<!-- Header section end -->

{% block body %}
    <div id="content">
        {% block content %}
        {% endblock %}
    </div>
{% endblock %}

<!-- Footer section start -->
<footer class="footer-section">
    <a id="contact"></a>
    <div class="footer-social">
        <div class="social-links">
            <a href="https://www.youtube.com/@MetaDesign_remont"><i class="fa fa-youtube"></i></a>
            <a href="https://www.instagram.com/meta_design.diz?igsh=bmMxZmVteHIzeTBz"><i class="fa fa-instagram"></i></a>
            <a href="https://t.me/metadesign_remont"><i class="fa fa-telegram"></i></a>
            <a href="https://api.whatsapp.com/send/?phone={{ PHONE }}"><i class="fa fa-whatsapp"></i></a>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-lg-9 offset-lg-1">
                <div class="row">
                    <div class="col-md-4 offset-1">
                        <div class="footer-item">
                            <ul>
                                <li><a href="/">Главная</a></li>
                                <li><a href="/about">О нас</a></li>
                                <li><a href="/portfolio">Портфолио</a></li>
                                <li><a href="/#services">Услуги</a></li>
                                <li><a href="/#contact">Контакты</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4 offset-3 pt-4" style="font-size: 1.2rem">
                        <div class="extra-content mb-2">
                            <a href="/privacy" class="footer-link">Политика конфиденциальности</a>
                        </div>
                        <div class="extra-content mb-2">
                            Email: <a href="mailto:inbox@metadiz.ru" class="footer-link">inbox@metadiz.ru</a>
                        </div>

                        <div class="extra-content mb-2">
                            Телефон: +7 925 002 4973
                        </div>

                    </div>
                </div>
                <div class="row">
                    <div class="offset-5 pb-3">
                        Copyright &copy; <script>document.write(new Date().getFullYear());</script> All rights reserved.
                        <br>
                        {#        This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>#}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->

</footer>
<!-- Footer section end -->

<style>
    .footer-section .extra-content a {
        color: inherit;
        text-decoration: underline;
        font-size: 1.1rem;
    }
    .footer-section .extra-content a:hover {
        color: inherit;
        text-decoration-thickness: 2px;
    }
</style>

<div class="fixed-panel btnModalCalculator">
    <svg fill="#000" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 183.5 183.5" style="enable-background:new 0 0 183.5 183.5;" xml:space="preserve"><path d="M145,183.5H38.5C17.271,183.5,0,166.229,0,145V38.5C0,17.271,17.271,0,38.5,0H145c21.229,0,38.5,17.271,38.5,38.5V145C183.5,166.229,166.229,183.5,145,183.5z M94.75,177.5H145c17.921,0,32.5-14.58,32.5-32.5V94.75H94.75V177.5z M6,94.75V145c0,17.92,14.579,32.5,32.5,32.5h50.25V94.75H6z M94.75,88.75h82.75V38.5C177.5,20.58,162.921,6,145,6H94.75V88.75z M6,88.75h82.75V6H38.5C20.579,6,6,20.58,6,38.5V88.75z M62.61,151.24c-0.768,0-1.535-0.293-2.121-0.878l-11.786-11.786l-11.785,11.786c-1.172,1.171-3.07,1.171-4.242,0c-1.172-1.171-1.172-3.071,0-4.242l11.785-11.786l-11.785-11.785c-1.172-1.171-1.172-3.071,0-4.242c1.172-1.172,3.07-1.171,4.242,0l11.785,11.786l11.786-11.786c1.172-1.171,3.07-1.171,4.242,0c1.172,1.171,1.172,3.071,0,4.242l-11.785,11.785l11.785,11.786c1.172,1.171,1.172,3.071,0,4.242C64.146,150.947,63.378,151.24,62.61,151.24z M137.64,151.24h-0.073c-1.657,0-3-1.343-3-3s1.343-3,3-3s3.037,1.343,3.037,3S139.297,151.24,137.64,151.24z M153.629,137.333h-32.052c-1.657,0-3-1.343-3-3s1.343-3,3-3h32.052c1.657,0,3,1.343,3,3S155.286,137.333,153.629,137.333z M137.671,123.427h-0.136c-1.657,0-3-1.343-3-3s1.343-3,3-3h0.136c1.657,0,3,1.343,3,3S139.328,123.427,137.671,123.427z M48.703,64.667c-1.657,0-3-1.343-3-3V48.333H32.37c-1.657,0-3-1.343-3-3s1.343-3,3-3h13.333V29c0-1.657,1.343-3,3-3s3,1.343,3,3v13.333h13.334c1.657,0,3,1.343,3,3s-1.343,3-3,3H51.703v13.333C51.703,63.323,50.36,64.667,48.703,64.667z M153.937,48.333H121.27c-1.657,0-3-1.343-3-3s1.343-3,3-3h32.667c1.657,0,3,1.343,3,3S155.594,48.333,153.937,48.333z"></path></svg>
    <span class="ml-3">Рассчитать</span>
</div>

<!-- Модальное окно калькулятора -->
<div class="modal" tabindex="-1" id="myModalCalculator">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Калькулятор стоимости ремонта</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                {{ include('index/_calculator.html.twig') }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Закрыть</button>
                <button type="button" id="btnSubmit" class="btn btn-primary">Рассчитать стоимость</button>
            </div>
        </div>
    </div>
</div>
<!-- /Модальное окно калькулятора -->

<!-- Модальное окно результатов рассчета -->
<div class="modal" tabindex="-1" id="modalResult">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Результаты расчета</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="response-loader" style="text-align: center">
                    <div class="spinner-border text-dark" role="status">
                        <span class="sr-only">Загрузка...</span>
                    </div>
                </div>
                <p></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Закрыть</button>
                <button type="button" id="btnRepeat" class="btn btn-primary" data-dismiss="modal">Создать еще одну заявку</button>
            </div>
        </div>
    </div>
</div>
<!-- /Модальное окно результатов рассчета -->

<!--====== Javascripts & Jquery ======-->

<script src="{{ asset('js/jquery-2.1.4.min.js') }}"></script>
<script src="{{ asset('js/bootstrap.min.js') }}"></script>
<script src="{{ asset('js/isotope.pkgd.min.js') }}"></script>
<script src="{{ asset('js/owl.carousel.min.js') }}"></script>
<script src="{{ asset('js/jquery.owl-filter.js') }}"></script>
<script src="{{ asset('js/magnific-popup.min.js') }}"></script>
<script src="{{ asset('js/circle-progress.min.js') }}"></script>
<script src="{{ asset('js/masonry.pkgd.min.js') }}"></script>
<script src="{{ asset('js/imagesloaded.js') }}"></script>
<script src="{{ asset('js/main.js') }}"></script>
<script src="{{ asset('js/jquery.inputmask.bundle.js') }}"></script>
<script src="{{ asset('js/calculator.js') }}"></script>
<script src="{{ asset('js/feedback.js') }}"></script>
</body>
</html>