{% extends 'base.html.twig' %}

{% block title %}О нас{% endblock %}

{% block content %}


    <!-- Page header section start -->
    <section class="page-header-section set-bg section-about" data-setbg="/img/bg_MD_2.jpg">
        <div style="">
