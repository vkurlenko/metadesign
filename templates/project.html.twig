{% extends 'base.html.twig' %}

{% block title %}Проект{% endblock %}

{% block content %}

    <!-- Page header section start -->
    <section class="page-header-section set-bg section-about" data-setbg="/img/bg_MD_3.jpg">
        <div class="container project-content">
            <h1 class="header-title" style="margin-bottom: 1.5rem">{{ PROJECT.name }}</h1>
            <div>
                <p style="color: #baff00; margin-bottom: 0">{{ PROJECT.text }}</p>
                {% if PROJECT.city != "Одинцово" %}
                    <h2 style="color: #FFFFFF; font-size: 30px">{{ PROJECT.city }}</h2>
                {% endif %}
            </div>
        </div>
    </section>
    <!-- Page header section end -->


    <!-- Page section start -->
    <div class="page-section" >
        <div class="container">

            <div class="py-3">
                <a href="/portfolio" class="site-btn sb-dark">Проекты</a>
            </div>
            <p class="pt-5">
                {{ PROJECT.description }}
            </p>
        </div>

        <div class="">
            <div class="grid zoom-gallery">
                <div class="grid-sizer"></div>

                {% for IMAGE in PROJECT.files %}
                    <div class="grid-item">
                        <a href="{{ IMAGE }}" title="test">
                            <img src="{{ IMAGE }}" alt="text" >
                        </a>
                    </div>
                {% endfor %}

            </div>
        </div>
    </div>
    <!-- Page section end -->

{% endblock %}