<div class="container">
    <div class="row">
        <div class="col-lg-3">
            <div class="section-title">
                <h1>Портфолио</h1>
            </div>
        </div>

        <div class="col-lg-9">
            <ul class="projects-filter-nav">
                <li class="btn-filter" data-filter=".portfolio">Портфолио</li>
                <li class="btn-filter" data-filter=".projects">Проекты</li>
                <li class="btn-filter" data-filter=".drawings">Чертежи</li>
                <li class="btn-filter" data-filter=".building">Стройка</li>

            </ul>
        </div>
    </div>
</div>

<div id="projects-carousel" class="projects-slider">

    {% for ITEM in CARDS %}
            <div class="single-project set-bg {{ ITEM.group }}" data-setbg="{{ ITEM.img }}">
                <div class="project-content">
                    <h2>{{ ITEM.title }}</h2>
                    <p>{{ ITEM.text }}</p>
                    <a href="/project/{{ ITEM.id }}" id="{{ ITEM.id }}" class="seemore">Подробнее</a>
                </div>
            </div>
    {% endfor %}

</div>