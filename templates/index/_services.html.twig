<div class="container">
    <div class="section-title">
        <h2>Услуги</h2>
    </div>

    <p>
    <p>Начните прямо сейчас воплощать ваши мечты в реальность вместе с нами!</p>
    </p>

    <div class="row">

        {% for ITEM in SERVICES %}
            <div class="col-lg-4 col-md-6 pb-2">
                <a href="{{ ITEM.route }}/{{ ITEM.identifier }}">
                <div style="
                        height: 450px;
                        background-image: url({{ ITEM.img }});
                        background-repeat: no-repeat;
                        background-position: center;
                        background-size: cover;
                        "
                ></div>

                <div style="
                    max-width: 80%;
                    background: #fff;
                    color: #222;
                    position: relative;
                    bottom: 2rem;
                    padding: 1rem;
                    font-size: 2rem;
                    line-height: 2rem;
                "
                >
                    {{ ITEM.name }}
                </div>
                </a>
            </div>
        {% endfor %}

    </div>
</div>