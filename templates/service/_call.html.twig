<div class="container mt-4">
    <div class="row justify-content-center shadow-sm pb-2" style="background-color: #333 !important;">
        <div class="col-md-8 col-lg-auto">
            <form id="form-call" class="text-light p-4 rounded-3">
                <h1 class="mb-3 text-center text-light">Есть вопрос про {{ SERVICE.text }}?</h1>

                <!-- Поле имени (необязательное) -->
                <div class="mb-3">
                    <label for="user_name" class="form-label">Ваше имя</label>
                    <input type="text"
                           class="form-control"
                           id="user_name"
                           name="user_name"
                           aria-label="Ваше имя"
                           placeholder="Иван Иванов">
                </div>

                <!-- Поле телефона (обязательное) -->
                <div class="mb-4">
                    <label for="phone" class="form-label">Телефон</label>
                    <div class="input-group">
                        <span class="input-group-text">+7</span>
                        <input type="tel"
                               class="form-control"
                               id="phone"
                               name="phone"
                               aria-label="Номер телефона"
                               placeholder="(999) 999-99-99"
                               required>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <label class="form-label">Удобный способ связи:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="contact-call" name="contact_method[]" value="call" checked>
                        <label class="form-check-label" for="contact-call">
                            Звонок
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="contact-tg" name="contact_method[]" value="telegram">
                        <label class="form-check-label" for="contact-tg">
                            Telegram
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="contact-wa" name="contact_method[]" value="whatsapp">
                        <label class="form-check-label" for="contact-wa">
                            WhatsApp
                        </label>
                    </div>
                </div>

                <input type="hidden" name="service_id" value="{{ ID }}">

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary py-2">Отправить</button>
                </div>
            </form>
        </div>
    </div>
</div>